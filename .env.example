# Names only. Values live in Vercel project settings (scoped per environment) and in a local .env.local that is never committed.
# apps/web
DATABASE_URL=
AUTH_SUPABASE_URL=                 # injected by the Supabase Marketplace resource (prefix AUTH_); NEXT_PUBLIC_SUPABASE_URL also accepted
AUTH_SUPABASE_PUBLISHABLE_KEY=     # same; NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also accepted
AI_GATEWAY_API_KEY=
AI_PRIMARY_MODEL=
AI_FALLBACK_MODEL=
AI_ENABLED=
ERP_BASE_URL=
ERP_AUTH=                      # unset = send the deployment's Vercel OIDC token; 'secret' forces the shared secret
ERP_SERVICE_TOKEN=             # shared-secret fallback only
DEMO_CONTROLS_ENABLED=
AI_ZERO_DATA_RETENTION=        # true asks the Gateway for zero-data-retention providers only (Pro/Enterprise)
DESK_WEBHOOK_SECRET=           # shared with the desk; verifies the signed finance webhook
CRON_SECRET=                   # Vercel Cron sends it as a bearer token; unset refuses every call to the load route
APP_VERSION_LABEL=             # optional: a small label next to the wordmark, used during rolling-release rehearsals
TOOLBAR_ENABLED=               # true renders the Vercel Toolbar (flags) for team members
# apps/erp-stub
ERP_DATABASE_URL=
ERP_OIDC_ISSUER=               # https://oidc.vercel.com/<team>
ERP_OIDC_AUDIENCE=             # https://vercel.com/<team>
ERP_ALLOWED_SUBJECTS=          # owner:<team>:project:<web project>:environment:production,...:preview,...:development
ERP_ALLOW_SHARED_SECRET=       # true keeps ERP_SERVICE_TOKEN as a fallback credential
DESK_WEBHOOK_SECRET=           # same value as the hub's; signs each finance decision
DESK_WEBHOOK_URL=              # the hub's webhook, https://<hub>/api/webhooks/service-desk (also where tickets link back)
# tests / evals (never production data)
TEST_DATABASE_URL=
# one-time, owner's machine only: creating the test users (AUTH_SUPABASE_SECRET_KEY arrives with `vercel env pull`; never read by the app)
TEST_USER_PASSWORD=
